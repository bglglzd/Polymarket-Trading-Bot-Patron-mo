# PolyPatronBot Environment Variables
# Copy this to .env and fill in your values

# ── Trading Mode ──────────────────────────────────────────────
ENABLE_LIVE_TRADING=false

# ── Polymarket API (required for live trading) ────────────────
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here

# ── AI Analysis ───────────────────────────────────────────────
# Powered by Codex CLI — login with: codex login
# No API key needed, uses your Codex subscription

# ── Telegram Notifications ────────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Bot username (without @) — used for Telegram Login Widget
TELEGRAM_BOT_USERNAME=your_bot_username
# Your Telegram user ID — only this user can access the dashboard
TELEGRAM_ADMIN_ID=your_telegram_user_id

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=3000
# Your dashboard domain (for CORS) — e.g. https://poly.qzx.digital
DASHBOARD_ORIGIN=https://poly.qzx.digital

# ── Node Environment ──────────────────────────────────────────
NODE_ENV=production
